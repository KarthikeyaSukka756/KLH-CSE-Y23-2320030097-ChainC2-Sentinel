# ChainC2 Sentinel — Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# .env is git-ignored; .env.example is committed.

# ============================================================
# Hardhat / Blockchain
# ============================================================
HARDHAT_NODE_HOST=hardhat-node
HARDHAT_NODE_PORT=8545
HARDHAT_CHAIN_ID=31337

# ============================================================
# RPC Proxy
# ============================================================
RPC_PROXY_HOST=rpc-proxy
RPC_PROXY_PORT=8546
RPC_UPSTREAM_URL=http://hardhat-node:8545

# ============================================================
# HTTP Target (controlled network destination)
# ============================================================
HTTP_TARGET_HOST=http-target
HTTP_TARGET_PORT=8080

# ============================================================
# Telemetry Output
# ============================================================
TELEMETRY_OUTPUT_DIR=data/telemetry

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Docker Compose — optional host port overrides for debugging
# Set these to expose internal ports on the host machine.
# Leave empty to keep ports internal-only.
# ============================================================
# DEBUG_HARDHAT_PORT=8545
# DEBUG_RPC_PROXY_PORT=8546
# DEBUG_HTTP_TARGET_PORT=8080
