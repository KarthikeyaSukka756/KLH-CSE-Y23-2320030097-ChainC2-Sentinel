    "deploy:local": "hardhat run scripts/deploy.js --network hardhat_docker"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
