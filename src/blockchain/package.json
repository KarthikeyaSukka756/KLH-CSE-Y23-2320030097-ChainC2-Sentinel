{
  "name": "chainc2-sentinel-blockchain",
  "version": "0.1.0",
  "description": "ChainC2 Sentinel — Local Hardhat EVM environment with test contracts",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node --hostname 0.0.0.0",
